<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="stats">
  <table class="barbs-table stats">
    <thead>
      <tr>
        <th>Stat</th>{{#if isNpc}}<th data-tooltip="A fixed stat-block value replaces the attribute formula">Fixed</th>{{/if}}<th>Base</th>
        <th data-tooltip="Flat bonuses from effects' Changes (+40 AC, +5 points of a % stat), plus always-on roll modifiers marked (mods)">Bonus</th>
        <th data-tooltip="&quot;Increased by X%&quot; Changes, summed: Value = (Base + Bonus) × (1 + Multiplier)">Multiplier</th>
        <th>Value</th>
      </tr>
    </thead>
    <tbody>
      {{#each stats as |stat|}}
      <tr>
        <td>{{#if stat.rollable}}<a data-action="rollPercentStat" data-stat="{{stat.key}}" data-tooltip="Roll d100"><i class="fa-solid fa-dice-d20"></i> {{stat.label}}</a>{{else}}{{stat.label}}{{/if}}</td>
        {{#if @root.isNpc}}<td><input type="number" name="system.overrides.{{stat.key}}" value="{{stat.override}}" placeholder="—" /></td>{{/if}}
        <td>{{stat.base}}</td>
        <td>
          {{#if stat.bonus}}{{numberFormat stat.bonus sign=true}}{{/if}}
          {{#if stat.mods}}<span class="hint" data-tooltip="Roll modifiers: {{stat.modSources}}">{{numberFormat stat.mods sign=true}} (mods)</span>{{/if}}
        </td>
        <td>{{#if stat.multiplier}}{{numberFormat stat.multiplier sign=true}}%{{/if}}</td>
        <td class="value">{{stat.total}}{{stat.unit}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  <p class="hint">
    Everything here comes from attributes plus active effects: buffs, conditions, and equipped gear, both their Changes
    and their always-on roll modifiers (hover a number for where it comes from). Bonuses that only apply sometimes, like a
    weapon's own mods, are listed at the bottom.
  </p>

  <div class="stat-sections">
    {{#each statSections as |section|}}
    <table class="barbs-table stat-section{{#if section.wide}} wide{{/if}}">
      <thead><tr><th colspan="2">{{section.label}}</th></tr></thead>
      <tbody>
        {{#each section.lines as |line|}}<tr><td colspan="2">{{line}}</td></tr>{{/each}}
        {{#each section.rows as |r|}}
        <tr class="{{#if r.zero}}zero{{/if}}"{{#if r.hint}} data-tooltip="{{r.hint}}"{{/if}}>
          <td>{{r.label}}</td>
          <td class="value">{{r.text}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{/each}}
  </div>
</section>
