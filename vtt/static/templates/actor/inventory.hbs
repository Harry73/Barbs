<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="inventory">
  <div class="barbs-toolbar">
    {{#if editable}}<button type="button" data-action="createItem" data-type="equipment"><i class="fa-solid fa-plus"></i> Add item</button>{{/if}}
  </div>
  <table class="barbs-table inventory">
    <thead>
      <tr><th>Equipped</th><th>Item</th><th>Weapon</th><th>Qty</th><th>Weight</th><th></th></tr>
    </thead>
    {{#each inventory as |section|}}
    <tbody data-slot="{{section.slot}}">
      <tr class="inventory-section"><th colspan="6">{{section.label}}</th></tr>
      {{#each section.items as |entry|}}
      <tr data-item-id="{{entry.item.id}}">
        <td><a data-action="toggleEquipped" data-tooltip="{{#if entry.system.equipped}}Equipped: click to unequip{{else}}Not equipped: click to equip{{/if}}"><i class="{{#if entry.system.equipped}}fa-solid fa-square-check{{else}}fa-regular fa-square{{/if}}"></i></a></td>
        <td>
          <a data-action="editItem">{{entry.item.name}}</a>
          {{#if entry.system.use.enabled}}<span class="hint" data-tooltip="Usable from the Actions tab">usable</span>{{/if}}
          {{#if entry.system.ammo}}<span class="hint" data-tooltip="Ammunition: fired by ranged attacks while equipped">ammo</span>{{/if}}
        </td>
        <td>{{#if entry.weaponSummary}}<span class="{{#unless entry.system.isHeldWeapon}}unheld{{/unless}}"
              data-tooltip="{{#if entry.system.isHeldWeapon}}Attack from the Actions tab{{else}}Equip in a hand slot to attack with it{{/if}}"><i class="fa-solid fa-khanda"></i> {{entry.weaponSummary}}</span>{{/if}}</td>
        <td>{{entry.system.quantity}}</td>
        <td>{{entry.system.weight}}</td>
        <td>{{#if @root.editable}}<a data-action="deleteItem" data-tooltip="Remove"><i class="fa-solid fa-trash"></i></a>{{/if}}</td>
      </tr>
      {{else}}
      <tr class="inventory-empty"><td></td><td colspan="5" class="hint">Empty</td></tr>
      {{/each}}
    </tbody>
    {{/each}}
  </table>
</section>
