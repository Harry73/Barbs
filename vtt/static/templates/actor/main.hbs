<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="main">
  <h3>Downed</h3>
  <div class="barbs-row downed">
    <label data-tooltip="Death saves are rolled from the Actions tab while Downed.">Downed Health
      <input type="number" name="system.downed.value" value="{{system.downed.value}}" min="0" max="{{system.downed.max}}" />
      / {{system.downed.max}}
    </label>
  </div>

  <h3>Characteristics</h3>
  <div class="barbs-grid details">
    <label>Gender <input type="text" name="system.details.gender" value="{{system.details.gender}}" /></label>
    <label>Age <input type="text" name="system.details.age" value="{{system.details.age}}" /></label>
    <label>Height <input type="text" name="system.details.height" value="{{system.details.height}}" /></label>
    <label>Weight <input type="text" name="system.details.weight" value="{{system.details.weight}}" /></label>
    <label>Eyes <input type="text" name="system.details.eyes" value="{{system.details.eyes}}" /></label>
    <label>Hair <input type="text" name="system.details.hair" value="{{system.details.hair}}" /></label>
    <label>Alignment <input type="text" name="system.details.alignment" value="{{system.details.alignment}}" /></label>
    <label class="wide">Languages <input type="text" name="system.details.languages" value="{{system.details.languages}}" /></label>
    <label class="wide" data-tooltip="Comma-separated, e.g. &quot;demon&quot; or &quot;undead, construct&quot;. Used by &quot;vs demons&quot; bonuses (target:type:demon).">Creature types
      <input type="text" name="system.details.creatureTypes" value="{{system.details.creatureTypes}}" placeholder="humanoid" />
    </label>
  </div>

  <h3>Classes</h3>
  {{#if classRows.length}}
  <ul class="barbs-list">
    {{#each classRows as |c|}}
    <li class="barbs-list-row" data-item-id="{{c.itemId}}">
      <img src="{{c.img}}" alt="" />
      <a class="name" data-action="openClass" data-class="{{c.name}}">{{c.name}}</a>
      <span class="hint">
        {{#if c.abilities}}{{c.abilities}} abilit{{#if (eq c.abilities 1)}}y{{else}}ies{{/if}}, {{c.investment}} AP invested, tier {{c.unlockedTier}} unlocked{{else}}no abilities yet{{/if}}{{#if c.passive}} · {{c.passive}}{{/if}}
      </span>
      {{#if c.itemId}}{{#if @root.editable}}<a data-action="deleteItem" data-tooltip="Remove this class"><i class="fa-solid fa-trash"></i></a>{{/if}}{{/if}}
    </li>
    {{/each}}
  </ul>
  {{else}}
  <p class="hint">Classes appear here as you add abilities. You can also drag one in from the <a data-action="openCompendium" data-pack="classes">Classes compendium</a>.</p>
  {{/if}}
</section>
