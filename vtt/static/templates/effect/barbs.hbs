<section class="tab barbs-effect {{#if tab.active}}active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <div class="form-group">
    <label>Category</label>
    <div class="form-fields">
      <select name="system.category">{{selectOptions categoryChoices selected=barbs.category}}</select>
    </div>
    <p class="hint">Buffs count against Buff Limit. Conditions roll Condition Resist when applied from a card.</p>
  </div>
  <div class="form-group">
    <label>Single use</label>
    <div class="form-fields">
      <input type="checkbox" name="system.singleUse" {{checked barbs.singleUse}} />
    </div>
    <p class="hint">Removed after the first roll it modifies, like Assassin's Focus.</p>
  </div>
  <div class="form-group">
    <label>Block %</label>
    <div class="form-fields">
      <input type="number" name="system.block" value="{{barbs.block}}" min="0" max="100" step="1" />
    </div>
    <p class="hint">Reduces the next attack applied to the bearer by this much (100 = fully blocked), then is removed. 0 = not a block.</p>
  </div>

  <h4>Roll modifiers</h4>
  <p class="hint">
    Applied when this effect's actor makes a matching roll. Stat changes (e.g. <code>system.stats.ac.bonus</code>)
    go on the Changes tab instead. On-hit statuses take a status id and an optional chance: <code>stunned 25</code> is
    "25% chance to Stun"; damage-over-time ones take an amount, like <code>burned:10 30</code>. Tick "On crit" for
    "On crit: ..." affixes.
  </p>
  <p class="hint">
    <strong>Conditions</strong> limit a modifier: commas mean "and", <code>|</code> "or", <code>!</code> "not", and
    numbers compare (<code>target:health:percent &lt; 30</code>). Facts available: <code>roll:physical</code>,
    <code>weapon:bow</code>, <code>weapon:ranged</code>, <code>ranged</code>/<code>melee</code>, <code>hand:dual</code>,
    <code>ability:tag:spell</code>, <code>ability:class:sniper</code>, <code>area</code>, <code>in-combat</code>;
    <code>self:</code> or <code>target:</code> + <code>type:demon</code>, <code>status:prone</code>,
    <code>effect:rage</code>, <code>health:percent</code>, <code>buffs</code>, <code>level</code>;
    <code>target:mark:&lt;name&gt;</code> (an effect you put on them), <code>target:distance</code>.
    "Incoming" modifiers instead see <code>attack:…</code> (the attack's facts), <code>attacker:…</code>,
    <code>attacker:distance</code>, and <code>origin:attacker</code> (this effect came from the attacker).
  </p>
  <table class="barbs-modifiers">
    <thead>
      <tr>
        <th>Type</th><th>Roll</th><th>Damage type</th><th>Weapon</th><th>Value</th><th data-tooltip="Only when the hit crits">On crit</th><th data-tooltip="Optional conditions, e.g. target:type:demon, weapon:bow | weapon:crossbow, !self:status:hidden, target:health:percent < 30">Conditions</th>
        <th><a data-action="addModifier" data-tooltip="Add modifier"><i class="fa-solid fa-plus"></i></a></th>
      </tr>
    </thead>
    <tbody>
      {{#each modifiers as |m|}}
      <tr data-index="{{m.index}}">
        <td><select name="system.modifiers.{{m.index}}.type">{{selectOptions @root.typeChoices selected=m.type}}</select></td>
        <td><select name="system.modifiers.{{m.index}}.rollType">{{selectOptions @root.rollTypeChoices selected=m.rollType}}</select></td>
        <td><select name="system.modifiers.{{m.index}}.damageType">{{selectOptions @root.damageTypeChoices selected=m.damageType}}</select></td>
        <td><select name="system.modifiers.{{m.index}}.weapon">{{selectOptions @root.weaponChoices selected=m.weapon}}</select></td>
        <td><input type="text" name="system.modifiers.{{m.index}}.value" value="{{m.value}}" placeholder="2d8, 25, text" /></td>
        <td><input type="checkbox" name="system.modifiers.{{m.index}}.onCrit" {{checked m.onCrit}} /></td>
        <td><input type="text" name="system.modifiers.{{m.index}}.conditions" value="{{m.conditions}}" placeholder="always" /></td>
        <td><a data-action="deleteModifier" data-tooltip="Remove"><i class="fa-solid fa-trash"></i></a></td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</section>
