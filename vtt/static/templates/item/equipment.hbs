<section class="item-details">
  <div class="barbs-grid">
    <label>Slot
      <select name="system.slot">{{selectOptions slotChoices selected=system.slot}}</select>
    </label>
    <label class="checkbox">Equipped <input type="checkbox" name="system.equipped" {{checked system.equipped}} /></label>
    <label>Quantity <input type="number" name="system.quantity" value="{{system.quantity}}" min="0" /></label>
    <label>Weight <input type="number" name="system.weight" value="{{system.weight}}" min="0" step="any" /></label>
  </div>
  <h3>Use</h3>
  <div class="barbs-grid">
    <label class="checkbox" data-tooltip="Gives the item a Use button in the inventory">Usable <input type="checkbox" name="system.use.enabled" {{checked system.use.enabled}} /></label>
    {{#if system.use.enabled}}
    <label>Used on
      <select name="system.use.target">{{selectOptions useTargetChoices selected=system.use.target}}</select>
    </label>
    <label>Heal <input type="text" name="system.use.heal" value="{{system.use.heal}}" placeholder="4d10" /></label>
    <label>Restore
      <select name="system.use.restoreResource">{{selectOptions restoreChoices selected=system.use.restoreResource}}</select>
    </label>
    <label>Restore amount <input type="text" name="system.use.restore" value="{{system.use.restore}}" placeholder="30" /></label>
    <label class="checkbox">Use one up <input type="checkbox" name="system.use.consume" {{checked system.use.consume}} /></label>
    <label class="wide">Note <input type="text" name="system.use.note" value="{{system.use.note}}" placeholder="Shown on the card" /></label>
    {{/if}}
    <label class="checkbox" data-tooltip="While equipped, its effects apply to ranged physical attacks, and each shot uses one">Ammunition <input type="checkbox" name="system.ammo" {{checked system.ammo}} /></label>
  </div>
  {{#if system.use.enabled}}
  <p class="hint">Using it also applies the item's <em>Template</em> effects (below) to whoever it's used on.</p>
  {{/if}}

  <h3>Weapon</h3>
  <div class="barbs-grid">
    <label>Category
      <select name="system.weapon.category">{{selectOptions weaponCategoryChoices selected=system.weapon.category}}</select>
    </label>
    <label>Damage <input type="text" name="system.weapon.damage" value="{{system.weapon.damage}}" placeholder="1d8" /></label>
    <label>Damage type
      <select name="system.weapon.damageType">{{selectOptions damageTypeChoices selected=system.weapon.damageType}}</select>
    </label>
    <label>Scaling
      <select name="system.weapon.scaling">{{selectOptions weaponScalingChoices selected=system.weapon.scaling}}</select>
    </label>
    <label>Crit chance (%) <input type="number" name="system.weapon.critChance" value="{{system.weapon.critChance}}" /></label>
    <label>Crit modifier (%) <input type="number" name="system.weapon.critModifier" value="{{system.weapon.critModifier}}" min="0" /></label>
  </div>
  <p class="hint">
    Mods and enchantments (on-hit damage, crit bonuses, ...) go in Bonuses below. On a weapon, attack bonuses and
    on-hit triggers apply to attacks made with this weapon, and to your spells while it's held. Stat bonuses apply
    while equipped.
  </p>
  <h3 class="barbs-heading-action">
    Bonuses
    {{#if editable}}<button type="button" data-action="editBonuses"><i class="fa-solid fa-pen-to-square"></i> Edit bonuses</button>{{/if}}
  </h3>
  {{#if (and bonusSummary.length (not system.equipped))}}
  <p class="notice"><i class="fa-solid fa-triangle-exclamation"></i> Not equipped, so these are inactive.</p>
  {{/if}}
  {{#each bonusSummary as |fx|}}
  <div class="barbs-bonus-summary" data-effect-id="{{fx.id}}">
    {{#if (gt @root.bonusSummary.length 1)}}<a class="barbs-bonus-source" data-action="editEffect">{{fx.name}}</a>{{/if}}
    <ul>
      {{#each fx.lines as |line|}}
      <li>{{line.text}}{{#if line.sub.length}}<ul>{{#each line.sub as |sub|}}<li>{{sub}}</li>{{/each}}</ul>{{/if}}</li>
      {{else}}
      <li class="hint">Nothing yet.</li>
      {{/each}}
    </ul>
  </div>
  {{else}}
  <p class="hint">No bonuses yet.</p>
  {{/each}}
  <details class="barbs-all-effects" {{#if allEffectsOpen}}open{{/if}}>
    <summary>All effects ({{effectCount}})</summary>
    {{> "systems/barbs/templates/item/effects-list.hbs"}}
  </details>
  <h3>Description</h3>
  {{#if editable}}
  <prose-mirror name="system.description" value="{{system.description}}" toggled>{{{enrichedDescription}}}</prose-mirror>
  {{else}}
  <div class="description">{{{enrichedDescription}}}</div>
  {{/if}}
</section>
