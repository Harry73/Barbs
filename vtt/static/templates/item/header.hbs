<header class="barbs-header item-header">
  <img class="profile" src="{{item.img}}" alt="{{item.name}}" data-action="editImage" data-edit="img" />
  <div class="header-body">
    <input class="item-name" name="name" type="text" value="{{item.name}}" placeholder="Name" />
    <div class="header-summary">{{localize (concat "TYPES.Item." item.type)}}</div>
  </div>
</header>
